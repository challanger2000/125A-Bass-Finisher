<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <colors>
    <color name="Transparent" rgba="#00000000"/>
    <color name="Text" rgba="#F2F3F5FF"/>
    <color name="Muted" rgba="#ABB0B8FF"/>
    <color name="Minor" rgba="#747A84FF"/>
    <color name="Value" rgba="#E4E5E8FF"/>
    <color name="Accent" rgba="#7668FFFF"/>
    <color name="AccentDark" rgba="#4E43B8FF"/>
    <color name="SwitchBack" rgba="#0D0F12FF"/>
    <color name="SwitchFrame" rgba="#555B64FF"/>
    <color name="StatusBack" rgba="#11151AFF"/>
  </colors>

  <fonts>
    <font name="Title" font-name="Arial" size="24" bold="true" italic="false"/>
    <font name="Subtitle" font-name="Arial" size="10" bold="true" italic="false"/>
    <font name="Section" font-name="Arial" size="13" bold="true" italic="false"/>
    <font name="Label" font-name="Arial" size="12" bold="true" italic="false"/>
    <font name="ValueFont" font-name="Arial" size="12" bold="false" italic="false"/>
    <font name="MinorFont" font-name="Arial" size="9" bold="false" italic="false"/>
    <font name="SwitchFont" font-name="Arial" size="10" bold="true" italic="false"/>
    <font name="StatusFont" font-name="Arial" size="11" bold="true" italic="false"/>
  </fonts>

  <gradients>
    <gradient name="SwitchNormal">
      <color-stop rgba="#0A0C0FFF" start="0"/>
      <color-stop rgba="#20242AFF" start="0.55"/>
      <color-stop rgba="#111419FF" start="1"/>
    </gradient>
    <gradient name="SwitchSelected">
      <color-stop rgba="#342D7AFF" start="0"/>
      <color-stop rgba="#7668FFFF" start="0.62"/>
      <color-stop rgba="#4E43B8FF" start="1"/>
    </gradient>
  </gradients>

